{
  "name": "obsidian-xuan-theme",
  "version": "1.0.0",
  "scripts": {
    "build": "sass styles/theme.scss theme.css --style=compressed --no-source-map && node scripts/sync-obsidian-entry.mjs",
    "dev": "sass styles/theme.scss theme.css --style=expanded --source-map --watch",
    "sync:obsidian": "node scripts/sync-obsidian-entry.mjs",
    "test:switch": "bash scripts/test-switch-square.sh",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "description": "Obsidian 主题，宣纸质感、宋韵留白。",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sogud/xuan-theme.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/sogud/xuan-theme/issues"
  },
  "homepage": "https://github.com/sogud/xuan-theme#readme",
  "devDependencies": {
    "chokidar": "^5.0.0",
    "sass": "^1.98.0"
  }
}
